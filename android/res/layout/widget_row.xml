<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row"
    android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_row_time" android:layout_width="48dp" android:layout_height="wrap_content" android:textColor="#536454" android:textSize="12sp" android:maxLines="1" />
  <TextView android:id="@+id/widget_row_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#293E34" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
